QMainWindow {
    background-color: rgb(90, 90, 90);
}

QLabel {
/*    background-color: rgb(75, 75, 75);*/
    color: rgb(50, 150, 255);
    font-size: 20px;
    font-family: arial, sans-serif;
}

QLabel#output {
    background-color: rgb(75, 75, 75);
    padding: 20px;

    border-radius: 10px;
}

QPushButton {
    background-color: rgb(75, 75, 75);
    color: rgb(50, 150, 255);
    font-size: 24px;
    font-family: arial, sans-serif;
    margin: 5px;
    padding: 10px;
}

QPushButton:hover {
    background-color: rgb(65, 65, 65);
}

QPushButton:pressed {
    background-color: rgb(50, 50, 50);
}

QLineEdit {
    background-color: rgb(75, 75, 75);
    color: rgb(50, 150, 255);
    font-size: 20px;
    font-family: arial, sans-serif;

    border: 1px solid rgb(50, 150, 255);
    border-radius: 10px;

    padding: 5px;
}

QRadioButton {
  accent-color: rgb(50, 150, 255);
  width: 20px;
  height: 20px;
  cursor: pointer;
}

QCheckBox {
  accent-color: rgb(50, 150, 255);
  width: 20px;
  height: 20px;
  alternate-background-color: #FFFFFF;
}